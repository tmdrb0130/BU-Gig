{
  "name": "bu-cmong-backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "worker": "tsx src/worker-main.ts",
    "migrate": "tsx src/migrate.ts",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "seed:dev": "tsx src/seed-dev.ts",
    "openapi": "tsx src/export-openapi.ts",
    "staff:grant": "tsx src/grant-staff.ts",
    "format": "prettier --write src tests *.json *.yaml *.md",
    "format:check": "prettier --check src tests *.json *.yaml *.md"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@electric-sql/pglite": "^0.3.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "helmet": "^8.0.0",
    "nodemailer": "^10.0.13",
    "pdfkit": "^0.17.0",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pdfkit": "^0.17.0",
    "@types/pg": "^8.11.0",
    "prettier": "^3.9.9",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
