# Supply secrets through your deployment secret manager. Never commit real values.
APP_ENV=staging
HOST=0.0.0.0
PORT=3000
PUBLIC_BASE_URL=https://api.example.invalid
WEB_ORIGIN=https://app.example.invalid
DATABASE_URL=postgres://user:replace@db.internal:5432/bu?sslmode=verify-full
SESSION_SECRET=replace-with-random-at-least-32-characters
WORKER_INLINE=false
STORAGE_DRIVER=s3
S3_REGION=ap-northeast-2
S3_BUCKET=replace-private-bucket
# Prefer workload identity. Optional S3_ENDPOINT for compatible private storage.
MAIL_DRIVER=smtp
SMTP_URL=smtps://replace:replace@smtp.example.invalid:465
MAIL_FROM=service@example.invalid
STAGING_RECIPIENT_ALLOWLIST=tester@example.invalid
SCANNER_DRIVER=clamd
CLAMD_HOST=clamd.internal
CLAMD_PORT=3310
PDF_FONT_PATH=/usr/share/fonts/truetype/nanum/NanumGothic.ttf
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
