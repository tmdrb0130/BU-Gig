APP_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://127.0.0.1:3000
WEB_ORIGIN=http://127.0.0.1:5173
# Set DATABASE_URL to use PostgreSQL; empty uses local PGlite in development only.
DATABASE_URL=
DATA_DIR=.data
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_IDLE_SECONDS=43200
SESSION_ABSOLUTE_SECONDS=86400
REMEMBER_ABSOLUTE_SECONDS=604800
WORKER_INLINE=true
STORAGE_DRIVER=local
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=bu-cmong-private
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
MAIL_DRIVER=file
# SMTP_URL=
MAIL_FROM=noreply@example.invalid
# STAGING_RECIPIENT_ALLOWLIST=
SCANNER_DRIVER=development
